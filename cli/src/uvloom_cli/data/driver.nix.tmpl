# Generated by uvloom — do not edit; regenerated on every sync.
# Conventional Nix: pins use builtins.fetchTree (via pins.nix), no flakes.
let
  pins = import @pins@;
  pkgs = import pins.nixpkgs { };
  inherit (pkgs) lib;

  uvloomLib = import @uvloomLib@ {
    inherit lib;
    inherit (pins) uv2nix pyproject-nix pyproject-build-systems;
  };

  project = uvloomLib.project.load {
    root = @projectRoot@;
    filterSource = @filterSource@;
    extraSourcePaths = @extraSourcePaths@;
  };

  # Overlay order (spec req 14): pyproject-build-systems is applied by the
  # library itself; here we add hammer overrides, then the user's uv.nix.
  # The library adds editable-wheel build requirements for every local
  # editable/directory package.
  scope = project.forPython {
    inherit pkgs;
    interpreter = @interpreter@;
    sourcePreference = @sourcePreference@;
    overlays = @hammerOverlay@ ++ @userOverlay@;
    @dependencies@
  };
in
{
  venv = scope.venv {
    name = @venvName@;
    editable = @editable@;
  };

  # A file whose contents is the absolute path of the python executable;
  # realizing it also realizes the interpreter itself.
  interpreter = pkgs.writeText "uvloom-interpreter-path" (lib.getExe scope.interpreter);

  check = scope.check.pytest {
    @checkGroups@
    paths = @checkPaths@;
    pytestFlags = @checkFlags@;
  };
}
