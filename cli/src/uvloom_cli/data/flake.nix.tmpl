{
  description = "@name@ — uvloom environment (generated by `uvloom flakify`)";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/@nixpkgsRev@";
    # uvloom publishes no release revisions the CLI could pin from; this input
    # tracks the default branch. Pin it manually for full reproducibility.
    uvloom.url = "github:fornybar/uvloom";
    uvloom.inputs.nixpkgs.follows = "nixpkgs";
@hammerInput@  };

  outputs =
    { nixpkgs, uvloom@hammerArg@, ... }:
    let
      systems = [
        "x86_64-linux"
        "aarch64-linux"
        "x86_64-darwin"
        "aarch64-darwin"
      ];
      forAllSystems = nixpkgs.lib.genAttrs systems;
      project = uvloom.lib.project.load {
        root = ./.;
        filterSource = true;
        # extraSourcePaths = [ "tests" "data" ];
        # Set filterSource = false if your backend needs files uvloom cannot infer.
      };
      scopeFor =
        system:
        let
          pkgs = nixpkgs.legacyPackages.${system};
        in
        project.forPython {
          inherit pkgs;@interpreter@
          sourcePreference = "@sourcePreference@";
          overlays = [@overlays@];
        };
    in
    {
      packages = forAllSystems (system: {
        default = (scopeFor system).venv { name = "@name@-env"; };
      });

      devShells = forAllSystems (
        system:
        let
          pkgs = nixpkgs.legacyPackages.${system};
          scope = scopeFor system;
        in
        {
          default = pkgs.mkShell {
            packages = [
              (scope.venv { name = "@name@-dev-env"; })
              pkgs.uv
            ];

            shellHook = scope.hook;
          };
        }
      );
    };
}
